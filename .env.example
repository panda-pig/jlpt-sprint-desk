# Cloud sync (optional). Leave unset to run in local-only mode.
#
# 1. Create a free project at https://supabase.com
# 2. Run supabase/schema.sql in the project's SQL editor
# 3. Copy your project URL + anon key from Project Settings → API
# 4. Copy this file to .env and fill in the values below

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
