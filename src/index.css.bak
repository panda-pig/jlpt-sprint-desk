@import "tailwindcss";

@theme {
  --color-bg: #f6f7f4;
  --color-bg-strong: #edf3ef;
  --color-surface: #ffffff;
  --color-surface-muted: #f8faf8;
  --color-surface-tint: #e8f1ed;
  --color-ink: #182522;
  --color-ink-soft: #40534d;
  --color-muted: #70817a;
  --color-line: #dbe3df;
  --color-line-strong: #bccfc6;
  --color-primary: #315f4f;
  --color-primary-strong: #23483d;
  --color-primary-soft: #d9ebe4;
  --color-blue: #35647c;
  --color-teal: #2f7c75;
  --color-amber: #b77a20;
  --color-coral: #b95645;
  --color-green: #3d7757;
  --color-red: #b4232c;
  --color-purple: #6d5486;
  --color-gray: #7a8a84;
  --font-sans: "Avenir Next", Inter, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  --radius-lg: 8px;
  --radius-md: 6px;
  --radius-sm: 4px;
  --shadow-card: 0 16px 40px rgba(34, 53, 48, 0.08);
  --shadow-card-soft: 0 8px 22px rgba(34, 53, 48, 0.06);
}

* {
  box-sizing: border-box;
}

html {
  min-width: 320px;
  background: var(--color-bg);
}

body {
  margin: 0;
  min-height: 100vh;
  color: var(--color-ink);
  background: linear-gradient(180deg, rgba(232, 241, 237, 0.72), rgba(246, 247, 244, 0) 360px), var(--color-bg);
  font-family: var(--font-sans);
  font-size: 15px;
  line-height: 1.55;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

#root {
  width: 100%;
  max-width: 100%;
  margin: 0;
  text-align: left;
  border: none;
  min-height: 100vh;
}

/* App Shell */
.app-shell {
  display: flex;
  min-height: 100vh;
}

/* Sidebar */
.sidebar {
  width: 284px;
  min-width: 284px;
  background: var(--color-surface);
  border-right: 1px solid var(--color-line);
  display: flex;
  flex-direction: column;
  position: fixed;
  top: 0;
  left: 0;
  bottom: 0;
  z-index: 100;
  overflow-y: auto;
}

.brand-block {
  padding: 24px 20px;
  border-bottom: 1px solid var(--color-line);
}

.brand {
  display: flex;
  align-items: center;
  gap: 12px;
  text-decoration: none;
  color: var(--color-ink);
}

.brand-mark {
  width: 40px;
  height: 40px;
  background: var(--color-primary);
  color: white;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 16px;
}

.brand strong {
  display: block;
  font-size: 15px;
  font-weight: 600;
  line-height: 1.3;
}

.brand small {
  display: block;
  font-size: 12px;
  color: var(--color-muted);
  font-weight: 400;
}

.side-nav {
  flex: 1;
  padding: 12px;
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.side-nav a {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 10px 14px;
  border-radius: 6px;
  color: var(--color-ink-soft);
  text-decoration: none;
  font-size: 14px;
  font-weight: 500;
  transition: all 0.15s;
}

.side-nav a:hover {
  background: var(--color-surface-muted);
  color: var(--color-ink);
}

.side-nav a.active {
  background: var(--color-primary-soft);
  color: var(--color-primary);
}

.nav-icon {
  width: 28px;
  height: 28px;
  border-radius: 6px;
  background: var(--color-bg-strong);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
  font-weight: 600;
  color: var(--color-ink-soft);
}

.side-nav a.active .nav-icon {
  background: var(--color-primary);
  color: white;
}

.side-footer {
  padding: 16px;
  border-top: 1px solid var(--color-line);
}

.side-footer p {
  font-size: 12px;
  color: var(--color-muted);
  margin-top: 8px;
  text-align: center;
}

/* Workspace */
.workspace {
  flex: 1;
  margin-left: 284px;
  display: flex;
  flex-direction: column;
  min-height: 100vh;
}

/* Topbar */
.topbar {
  height: 84px;
  background: var(--color-surface);
  border-bottom: 1px solid var(--color-line);
  display: flex;
  align-items: center;
  padding: 0 24px;
  gap: 16px;
  position: sticky;
  top: 0;
  z-index: 50;
}

.topbar .eyebrow {
  font-size: 12px;
  color: var(--color-muted);
  text-transform: uppercase;
  letter-spacing: 0.5px;
  margin: 0;
}

.topbar h1 {
  font-size: 20px;
  font-weight: 600;
  margin: 2px 0 0;
  color: var(--color-ink);
}

.top-status {
  margin-left: auto;
  display: flex;
  align-items: center;
  gap: 16px;
  font-size: 13px;
  color: var(--color-ink-soft);
}

/* Page */
.page {
  flex: 1;
  padding: 24px;
  max-width: 1200px;
}

/* Cards & Panels */
.panel {
  background: var(--color-surface);
  border: 1px solid var(--color-line);
  border-radius: 8px;
  padding: 20px;
  margin-bottom: 16px;
}

.panel h2 {
  font-size: 16px;
  font-weight: 600;
  margin: 0 0 12px;
  color: var(--color-ink);
}

.stat-card {
  background: var(--color-surface);
  border: 1px solid var(--color-line);
  border-radius: 8px;
  padding: 20px;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.stat-card .label {
  font-size: 12px;
  color: var(--color-muted);
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.stat-card .value {
  font-size: 28px;
  font-weight: 700;
  color: var(--color-ink);
  line-height: 1.2;
}

.stat-card .note {
  font-size: 13px;
  color: var(--color-ink-soft);
}

/* Tasks */
.task-row {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  padding: 12px 0;
  border-bottom: 1px solid var(--color-line);
}

.task-row:last-child {
  border-bottom: none;
}

.task-row .module-badge {
  width: 32px;
  height: 32px;
  border-radius: 6px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
  font-weight: 600;
  color: white;
  flex-shrink: 0;
}

.task-row .task-content {
  flex: 1;
  min-width: 0;
}

.task-row .task-title {
  font-weight: 600;
  font-size: 14px;
  color: var(--color-ink);
  margin-bottom: 2px;
}

.task-row .task-text {
  font-size: 13px;
  color: var(--color-ink-soft);
  line-height: 1.5;
}

.task-row .task-time {
  font-size: 13px;
  color: var(--color-muted);
  flex-shrink: 0;
  white-space: nowrap;
}

/* Forms */
.form-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16px;
}

.form-grid label {
  display: flex;
  flex-direction: column;
  gap: 6px;
  font-size: 13px;
  font-weight: 500;
  color: var(--color-ink-soft);
}

.form-grid input,
.form-grid select,
.form-grid textarea {
  padding: 10px 12px;
  border: 1px solid var(--color-line);
  border-radius: 6px;
  font-size: 14px;
  font-family: inherit;
  background: var(--color-surface);
  color: var(--color-ink);
  transition: border-color 0.15s;
}

.form-grid input:focus,
.form-grid select:focus,
.form-grid textarea:focus {
  outline: none;
  border-color: var(--color-primary);
}

/* Buttons */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 10px 20px;
  border-radius: 6px;
  font-size: 14px;
  font-weight: 600;
  font-family: inherit;
  cursor: pointer;
  border: none;
  transition: all 0.15s;
}

.btn-primary {
  background: var(--color-primary);
  color: white;
}

.btn-primary:hover {
  background: var(--color-primary-strong);
}

.btn-secondary {
  background: var(--color-surface-muted);
  color: var(--color-ink);
  border: 1px solid var(--color-line);
}

.btn-secondary:hover {
  background: var(--color-bg-strong);
}

.btn-ghost {
  background: transparent;
  color: var(--color-ink-soft);
}

.btn-ghost:hover {
  background: var(--color-surface-muted);
  color: var(--color-ink);
}

/* Empty State */
.empty-state {
  text-align: center;
  padding: 48px 24px;
  color: var(--color-muted);
}

.empty-state h3 {
  font-size: 16px;
  font-weight: 600;
  color: var(--color-ink);
  margin-bottom: 8px;
}

.empty-state p {
  font-size: 14px;
  margin-bottom: 16px;
}

/* Progress */
.progress-bar {
  height: 6px;
  background: var(--color-bg-strong);
  border-radius: 3px;
  overflow: hidden;
}

.progress-bar .fill {
  height: 100%;
  border-radius: 3px;
  transition: width 0.3s;
}

/* Tags & Chips */
.chip {
  display: inline-flex;
  align-items: center;
  padding: 4px 10px;
  border-radius: 4px;
  font-size: 12px;
  font-weight: 500;
  background: var(--color-bg-strong);
  color: var(--color-ink-soft);
}

.chip.active {
  background: var(--color-primary-soft);
  color: var(--color-primary);
}

/* Health indicators */
.health-ok { color: var(--color-green); }
.health-warn { color: var(--color-amber); }
.health-danger { color: var(--color-red); }

/* Record form */
.record-form {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16px;
}

.record-form .full-width {
  grid-column: span 2;
}

/* Export output */
.export-output {
  width: 100%;
  min-height: 200px;
  padding: 16px;
  border: 1px solid var(--color-line);
  border-radius: 6px;
  font-family: ui-monospace, Consolas, monospace;
  font-size: 13px;
  line-height: 1.6;
  background: var(--color-surface-muted);
  color: var(--color-ink);
  resize: vertical;
}

/* Responsive */
@media (max-width: 1024px) {
  .sidebar {
    transform: translateX(-100%);
    transition: transform 0.2s;
  }

  .sidebar.open {
    transform: translateX(0);
  }

  .workspace {
    margin-left: 0;
  }

  .form-grid {
    grid-template-columns: 1fr;
  }

  .record-form {
    grid-template-columns: 1fr;
  }

  .record-form .full-width {
    grid-column: span 1;
  }
}

/* Print */
@media print {
  .sidebar,
  .topbar,
  .btn {
    display: none !important;
  }

  .workspace {
    margin-left: 0;
  }

  .page {
    padding: 20px;
  }
}
